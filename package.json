{
  "name": "datascube",
  "version": "1.0.0",
  "description": "DataScube Microservice API - Enterprise-grade inquiry management system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js",
    "prepare": "husky install",
    "docker:build": "docker build -t datascube-api .",
    "docker:run": "docker run -p 3000:3000 --env-file .env datascube-api",
    "docker:push": "docker push ghcr.io/datascubesolutions/data-scube-be:latest",
    "k8s:deploy": "./scripts/deploy.sh",
    "k8s:logs": "kubectl logs -f deployment/datascube-api",
    "k8s:status": "kubectl get pods -l app=datascube-api",
    "health": "curl -f http://localhost:3000/api/health || exit 1"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "microservice",
    "api",
    "inquiry-management",
    "enterprise"
  ],
  "author": "Nikul Kumar",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.6",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  }
}
