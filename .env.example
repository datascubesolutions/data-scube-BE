# Application Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/datascube?retryWrites=true&w=majority&appName=dataScube
MONGODB_TEST_URI=mongodb+srv://username:password@cluster.mongodb.net/datascube_test?retryWrites=true&w=majority&appName=dataScube

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=24h

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_EMAIL=your-email@gmail.com
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-gmail-app-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/combined.log
ERROR_LOG_FILE=logs/error.log

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Health Check
HEALTH_CHECK_TIMEOUT=5000

# File Upload (if using multer)
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# API Configuration
API_BASE_URL=http://localhost:3000/api
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# WhatsApp Business API Configuration
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_NUMBER=+917300340014
WHATSAPP_ADMIN_PHONE=917300340014
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token